# One image for FASTER (A100/A40, SingularityCE) and the local RTX 5070 Ti (Apptainer).
# Build on your machine: `make container`, then rsync the .sif to $SOE_DATA/sif/ (docs/cluster.md).
# Base matches verl 0.9.1's reference image (docker/Dockerfile.uv.cu130): CUDA 13.0 needs driver
# >= 580; FASTER runs 580.126.20, the local 5070 Ti 595.99.02.
Bootstrap: docker
From: nvidia/cuda:13.0.2-devel-ubuntu24.04

%files
    pyproject.toml /opt/soe/pyproject.toml
    uv.lock /opt/soe/uv.lock
    README.md /opt/soe/README.md
    .python-version /opt/soe/.python-version

%environment
    export PATH=/opt/venv/bin:$PATH
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    # verl's image sets this: use the driver's CUDA, never the forward-compat libraries.
    export VLLM_ENABLE_CUDA_COMPATIBILITY=0

%post
    apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates \
        && rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/0.13.5/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    cd /opt/soe
    # Only dependencies go in; the soe package is bind-mounted from the repo at run time
    # (PYTHONPATH=$PWD), so code changes never need a rebuild. --no-cache keeps several GB of
    # wheels out of the image.
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy \
        uv sync --frozen --extra train --no-install-project --no-dev --no-cache

%test
    # Runs at build time without a GPU; flash-attn and the GPU checks run under --nv in
    # slurm/check_container.sbatch.
    python -c "import torch, vllm, verl, trl, transformers, math_verify; print('soe image ok', torch.__version__, vllm.__version__, verl.__version__)"
